#!/usr/bin/env bash
#
# post-checkout: 체크아웃한 브랜치에 Figma 재설계 병합 커밋이 없으면 경고만 한다(차단 없음).
# 재설계 이전 브랜치·worktree로 앱을 빌드해 "화면이 구버전으로 돌아간" 것처럼 보이는
# 사고(2026-09-18)를 체크아웃 시점에 알아채기 위함. 기준선은 pre-push와 같다.
#
redesign_baseline="81a5f25"
[ "${3:-0}" = "1" ] || exit 0   # 브랜치 체크아웃일 때만(파일 체크아웃 제외)
git cat-file -e "${redesign_baseline}^{commit}" 2>/dev/null || exit 0
if ! git merge-base --is-ancestor "$redesign_baseline" HEAD 2>/dev/null; then
  echo "⚠️  이 브랜치에는 Figma 재설계 병합(${redesign_baseline})이 없습니다 — 빌드하면 구버전 화면이 나옵니다." >&2
  echo "   작업할 거라면 먼저 main을 병합하세요: git merge main" >&2
fi
exit 0
